@page "/"
@using ChronoConfig.Validation
@using ChronoConfigLib
@inject IMainViewModel viewModel

<h1>Mix</h1>

<nav aria-label="breadcrumb">
    <ol class="breadcrumb">
        <li class="breadcrumb-item @(Model!.ViewMode == ViewModes.Step1 ? "active": "")">
            @if (Model.ViewMode > ViewModes.Step1)
            {
                <a href="#" @onclick="() => SetViewMode(ViewModes.Step1)" @onclick:preventDefault>Setup</a>
            } else
            {
                <text>Setup</text>
            }
        </li>
        <li class="breadcrumb-item @(Model.ViewMode == ViewModes.Step2 ? "active": "")">
            @if (Model.ViewMode > ViewModes.Step2)
            {
                <a href="#" @onclick="() => SetViewMode(ViewModes.Step2)" @onclick:preventDefault>Preview</a>
            }
            else
            {
                <text>Preview</text>
            }
        </li>
        <li class="breadcrumb-item @(Model.ViewMode == ViewModes.Step3 ? "active": "")">
            @if (Model.ViewMode > ViewModes.Step3)
            {
                <a href="#" @onclick="() => SetViewMode(ViewModes.Step3)" @onclick:preventDefault>Output</a>
            }
            else
            {
                <text>Output</text>
            }
        </li>
    </ol>
</nav>

@if (Model.ViewMode == ViewModes.Step1)
{
    <EditForm Model="Model" OnValidSubmit="Step1Submit">
        <CustomValidation @ref="customValidation" />
        <ValidationSummary />

        <div class="card">
            <div class="card-body">
                <div class="row g-2">
                    <div class="col-md">
                        <div class="form-floating">
                            <InputText @bind-Value="Model.Configuration.Bpm" id="bpm" class="form-control" />
                            <label for="bpm">BPM</label>
                        </div>
                    </div>
                    <div class="col-md">
                        <div class="form-floating">
                            <InputText @bind-Value="Model.Configuration.Fps" id="fps" class="form-control" />
                            <label for="fps">FPS</label>
                        </div>
                    </div>
                    <div class="col-md">
                        <div class="form-floating">
                            <InputText @bind-Value="Model.Configuration.Cadence" id="cadence" class="form-control" />
                            <label for="cadence">Cadence</label>
                        </div>
                    </div>
                    <div class="col-md">
                        <div class="form-floating">
                            <InputText @bind-Value="Model.Configuration.PromptInterval" id="prompt-interval" class="form-control" />
                            <label for="prompt-interval">Prompt Interval (in seconds)</label>
                        </div>
                    </div>
                    <div class="col-md">
                        <div class="form-floating">
                            <InputText @bind-Value="Model.Configuration.VideoLength" id="video-length" class="form-control" />
                            <label for="video-length">Video Length</label>
                        </div>
                    </div>
                </div>
            </div>

            <div class="card-footer">
                <div class="d-grid gap-2 d-md-flex justify-content-md-end">
                    <button type="submit" class="btn btn-primary">Next</button>
                </div>
            </div>
        </div>
    </EditForm>
} else if (Model.ViewMode == ViewModes.Step2)
{
    <div class="card">
        <div class="card-body">
            <table class="table">
                <thead>
                    <tr>
                        <th scope="col">Time</th>
                        <th scope="col">Frame</th>
                        <th scope="col">Strength</th>
                        <th scope="col">Zoom</th>
                        <th scope="col">X</th>
                        <th scope="col">Y</th>
                        <th scope="col">Z</th>
                        <th scope="col">Prompt</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var keyframe in keyframes!)
                    {
                        <tr>
                            <td>@keyframe.Time</td>
                            <td>@keyframe.FrameIndex</td>
                            <td>
                                <InputText @bind-Value="keyframe.Strength" class="form-control" />
                            </td>
                            <td>
                                <InputText @bind-Value="keyframe.Zoom" class="form-control" />
                            </td>
                            <td>
                                <InputText @bind-Value="keyframe.X" class="form-control" />
                            </td>
                            <td>
                                <InputText @bind-Value="keyframe.Y" class="form-control" />
                            </td>
                            <td>
                                <InputText @bind-Value="keyframe.Z" class="form-control" />
                            </td>
                            <td>
                                <InputText @bind-Value="keyframe.Prompt" class="form-control" />
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        <div class="card-footer">
            <div class="d-grid gap-2 d-md-flex justify-content-md-end">
                <button @onclick="() => Step2Submit()"  class="btn btn-primary me-md-2" type="button">Next</button>
                <button @onclick="() => SetViewMode(Model.ViewMode - 1)" type="button" class="btn btn-secondary">Back</button>
            </div>
        </div>
    </div>
} else
{
    <div class="card">
        <div class="card-body">
            <div class="mb-3">
                <label for="total-frames" class="form-label">Total Frames</label>
                <InputText @bind-Value="output!.TotalFrames" id="total-frames" class="form-control" />
            </div>
            <div class="mb-3">
                <label for="output" class="form-label">Prompts</label>
                <InputTextArea @bind-Value="output.PromptsJson" id="output" class="form-control" style="width: 100%;" rows="8"></InputTextArea>
            </div>
            <div class="mb-3">
                <label for="strength" class="form-label">Strength Schedule</label>
                <InputTextArea @bind-Value="output.StrengthSchedule" id="strength" class="form-control" style="width: 100%;" rows="8"></InputTextArea>
            </div>
            <div class="mb-3">
                <label for="translation-z" class="form-label">Translation Z</label>
                <InputTextArea @bind-Value="output.TranslationZ" id="translation-z" class="form-control" style="width: 100%;" rows="8"></InputTextArea>
            </div>
            <div class="mb-3">
                <label for="rotation-3dx" class="form-label">Rotation 3D X</label>
                <InputTextArea @bind-Value="output.Rotation3DX" id="rotation-3dx" class="form-control" style="width: 100%;" rows="8"></InputTextArea>
            </div>
            <div class="mb-3">
                <label for="rotation-3dy" class="form-label">Rotation 3D Y</label>
                <InputTextArea @bind-Value="output.Rotation3DY" id="rotation-3dy" class="form-control" style="width: 100%;" rows="8"></InputTextArea>
            </div>
            <div class="mb-3">
                <label for="rotation-3dz" class="form-label">Rotation 3D Z</label>
                <InputTextArea @bind-Value="output.Rotation3DZ" id="rotation-3dz" class="form-control" style="width: 100%;" rows="8"></InputTextArea>
            </div>
        </div>

        <div class="card-footer">
            <div class="d-grid gap-2 d-md-flex justify-content-md-end">
                <button @onclick="() => SetViewMode(Model.ViewMode - 1)" type="submit" class="btn btn-secondary">Back</button>
            </div>
        </div>
    </div>
}

@code {
    private CustomValidation? customValidation;
    private EditContext? editContext;
    private List<Keyframe>? keyframes;
    private Output? output;

    [SupplyParameterFromForm]
    private IMainViewModel? Model { get; set; }

    protected override void OnInitialized()
    {
        Model = viewModel;
        editContext = new(Model);
    }

    private void Step1Submit()
    {
        customValidation?.ClearErrors();

        var errors = Model!.Validate().ToDictionary(m => m.Key, m => new List<string> { m.Value });
        if (errors.Any())
        {
            customValidation?.DisplayErrors(errors);
        }
        else
        {
            Model.SavePreferences();
            Model.ViewMode = Model.ViewMode + 1;
            keyframes = Model.LoadKeyframes();
        }
    }

    private void Step2Submit()
    {
        Model!.ViewMode = Model.ViewMode + 1;
        output = Model.LoadOutput(keyframes!);
    }

    private void SetViewMode(ViewModes mode)
    {
        Model!.ViewMode = mode;
    }
}
